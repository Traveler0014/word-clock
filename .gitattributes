# 换行符策略：仓库统一 LF，Windows 专用脚本强制 CRLF
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

# 二进制（防止误做换行转换）
*.stl binary
*.3mf binary
*.gcode binary
*.png binary
*.jpg binary

# 硬件产物按二进制处理：Gerber/KiCad/STEP 不应被换行规范化改写（打样需字节一致）
hardware/fab/** binary
hardware/*.kicad_pcb binary
hardware/*.kicad_sch binary
hardware/*.kicad_pro binary
hardware/**/*.step binary
hardware/**/*.csv text eol=lf
